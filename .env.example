# Template de variaveis de ambiente — Sistema MM Solucoes.
# Copie para `.env` e preencha. NUNCA commite o `.env` nem valores reais aqui.

# --- Banco (obrigatorio) ---------------------------------------------------
# PostgreSQL local via docker-compose.yml (porta 5436, para nao colidir com os
# outros projetos da maquina). Suba com: docker compose up -d
DATABASE_URL="postgres://dev:dev@localhost:5436/mmsolucoes_dev"

# --- Webhook (obrigatorio) -------------------------------------------------
# Segredo que autentica as chamadas em POST /api/integracoes/webhook/[canal] e
# POST /api/integracoes/worker. Viaja na query string (`?t=...`) porque o
# Mercado Livre nao assina notificacao nem aceita cabecalho customizado — so
# deixa configurar a URL de callback.
#
# SEM ESTA VARIAVEL AS DUAS ROTAS RESPONDEM 503 e nada entra. E falha FECHADA
# de proposito: abrir quando falta configuracao deixaria a porta escancarada
# justamente no ambiente mal configurado. Se o webhook "nao funciona" e o log
# diz "WEBHOOK_SECRET nao configurada", e isto aqui.
#
# Gere um valor proprio por ambiente (nunca reaproveite entre dev/HML/PRD):
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=""


# --- Storage das fotos / MinIO (obrigatorio p/ o CMS e o site) -------------
# Local: `docker compose up -d minio` sobe tudo, e
# `node scripts/storage/prova-minio.mjs` cria o bucket, aplica a politica de
# leitura publica e prova a ida e volta. Console web em http://localhost:9001
#
# SAO DUAS URLS de proposito: a aplicacao fala com o MinIO pela rede INTERNA
# (mais rapida, nao sai para a internet), mas quem BAIXA a foto e o navegador do
# visitante e o Mercado Livre — os dois precisam do dominio PUBLICO. Uma
# variavel so obrigaria a escolher entre upload interno e link que funciona fora.
MINIO_ENDPOINT="http://localhost:9000"
MINIO_ACCESS_KEY="dev"
MINIO_SECRET_KEY="devdevdev"
MINIO_BUCKET="mm-fotos"
# Base publica das fotos. Em producao, o dominio do MinIO (ex.:
# https://fotos.dominio.com.br). Vazio aqui = cai no MINIO_ENDPOINT.
MINIO_PUBLIC_URL=""
# Regiao usada na assinatura S3. Vazio = us-east-1.
MINIO_REGION=""


# --- Cofre de credenciais (obrigatorio para conectar qualquer canal) --------
# Chave AES-256-GCM que cifra os tokens de canal em `integracoes_credenciais`.
# Sem ela o cofre recusa gravar — e a falha aparece so DEPOIS de voce percorrer
# todo o fluxo de autorizacao do Mercado Livre, na hora de salvar o token.
#
# Protege contra dump de banco vazado: sem a chave, o token e texto inutil.
# NAO protege se a chave vazar junto com o dump — por isso ela vive aqui, na
# variavel de ambiente da aplicacao, e nunca no banco nem no backup.
# Use uma chave DIFERENTE por ambiente e nunca a rotacione sem antes decifrar e
# regravar as credenciais existentes.
#
# Gere com:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CREDENCIAIS_KEY=""


# --- Mercado Livre: o CODIGO existe, falta a credencial --------------------
# Diferente dos blocos abaixo: o fluxo OAuth ja esta implementado (rotas
# /api/integracoes/oauth/mercado-livre/iniciar e /callback, token cifrado no
# cofre). O que falta e o app registrado no portal de developers.
#
# Passos: Anderson cria o app na conta de vendedor da MM, copia id e secret, e
# cadastra o redirect URI EXATAMENTE igual ao valor abaixo (o ML compara string;
# barra a mais ja e motivo de recusa). Em dev, a URL publica exige tunel.
# Depois de preencher, abrir UMA vez no navegador:
#   https://SEU-DOMINIO/api/integracoes/oauth/mercado-livre/iniciar?t=$WEBHOOK_SECRET
ML_CLIENT_ID=""
ML_CLIENT_SECRET=""
ML_REDIRECT_URI="http://localhost:3000/api/integracoes/oauth/mercado-livre/callback"
# Base da API do ML. Vazio = a oficial. So mude para apontar para um mock.
ML_API_BASE=""


# --- Integracoes ainda pendentes de DECISAO --------------------------------
# Nada abaixo esta contratado ou configurado, e nao ha codigo para eles.
# Antes de descomentar qualquer bloco, leia docs/known-issues.md.
# ML_WEBHOOK_URL=

# OLX — nao confirmado se a conta da MM tem acesso a API de importacao de
# anuncios. Sem API, a tela vira cadastro manual e o escopo muda.
# Ver known-issues.md > "OLX — confirmar se a conta tem acesso a API".
# OLX_CLIENT_ID=
# OLX_CLIENT_SECRET=

# WhatsApp — nivel de integracao NAO decidido: Business App (link wa.me, manual)
# ou Cloud API (Meta, com custo por conversa e template aprovado). Os alertas
# automaticos de SLA e despacho so existem na Cloud API.
# Ver known-issues.md > "WhatsApp — qual nivel de integracao".
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# NF-e — emissor fiscal ainda nao escolhido e sem certificado A1. A etapa
# "NF-e emitida" e a primeira do stepper de expedicao; sem isso o fluxo nao
# fecha. Ver known-issues.md > "Emissao de NF-e — nao definida".
# NFE_PROVIDER=
# NFE_API_TOKEN=
# NFE_AMBIENTE=
